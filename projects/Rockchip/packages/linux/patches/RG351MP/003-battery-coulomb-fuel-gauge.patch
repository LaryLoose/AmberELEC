+/*
+ * Learn the real full-charge capacity by counting the coulombs delivered from
+ * a full charge (CHARGE_FINISH) down to empty (pwroff). Uses an own integrator
+ * because the OCV re-anchor resets the hw coulomb registers. Tracks ageing and
+ * persists the result to NEW_FCC.
+ */
+static void rk817_bat_fcc_learn(struct rk817_battery_device *battery)
+{
+	unsigned long now = get_boot_sec();
+	unsigned long dt = (battery->learn_last_sec &&
+			    now > battery->learn_last_sec) ?
+			   now - battery->learn_last_sec : 0;
+
+	battery->learn_last_sec = now;
+
+	/* (re)anchor while full: this charger reports CHRG_OFF (not CHARGE_FINISH)
+	 * at full, so key off the SoC (rsoc is in milli-%) instead */
+	if (battery->rsoc >= 99500) {
+		battery->learn_dis_uah = 0;
+		battery->learn_valid = true;
+		return;
+	}
+	if (battery->current_avg > 0) {	/* recharge before empty voids it */
+		battery->learn_valid = false;
+		return;
+	}
+	if (!battery->learn_valid)
+		return;
+
+	if (dt > 0 && dt < 300 && battery->current_avg < 0)
+		battery->learn_dis_uah +=
+			(s64)(-battery->current_avg) * dt * 1000 / 3600;
+
+	if (battery->voltage_avg <= battery->pdata->pwroff_vol) {
+		int learned = (int)(battery->learn_dis_uah / 1000);
+
+		battery->learn_valid = false;
+		if (learned > battery->pdata->design_capacity / 2 &&
+		    learned <= battery->pdata->design_qmax) {
+			battery->fcc = learned;
+			rk817_bat_save_fcc(battery, learned);
+		}
+	}
+}
