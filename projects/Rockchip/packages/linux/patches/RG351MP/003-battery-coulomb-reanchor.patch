From: AmberELEC battery coulomb fuel gauge
Subject: [PATCH] rk817_battery: real OCV table + idle re-anchor, report coulomb rsoc

The RG351MP shipped with a generic placeholder ocv_table (identical across
rg351mp/rg351v/xu10), bat_res=100 and design_capacity=3380, none of which match
the real cell. The vendor relax/OCV recalibration never triggers under emulation
load (the device rarely suspends), so the coulomb gauge drifts and AmberELEC
bypassed it with a raw-voltage capacity.

This makes the coulomb gauge itself trustworthy and reports it directly:

Device tree (both the default and timing_fix dts):
- ocv_table: measured on an RG351MP via a full IR-compensated discharge
  (tools/ocv_analyze.py); real Li-Ion shape, only the bottom 0/5% derived.
- bat_res 100 -> 154 mOhm (measured), design_capacity 3380 -> 2179 mAh
  (measured usable), design_qmax -> 2287.

Driver:
- rk817_bat_idle_ocv_calib(): re-anchor the coulomb counter to the
  IR-compensated OCV (V + |I|*bat_res) whenever the discharge current is low and
  steady for a while - re-implements the vendor relax calibration but triggered
  from the poll loop instead of suspend/resume, which never happens here.
- POWER_SUPPLY_PROP_CAPACITY (and STATUS/uevent) now report the raw coulomb SoC
  (rsoc) directly. rsoc is backed by the hardware coulomb counter and kept
  accurate by the table + re-anchor, so the lossy, stale-prone dsoc smoothing
  layer (which caused a stuck display after switching gauges) is no longer used
  for the user-facing value.
- The voltage-derived value moves to the read-only sysfs attribute
  /sys/class/power_supply/battery/capacity_voltage (was: capacity_coulomb).
---
--- a/drivers/power/rk817_battery.c
+++ b/drivers/power/rk817_battery.c
@@ -173,6 +173,11 @@
 #define SIMULATE_CHRG_K			1500
 #define FULL_CHRG_K			400
 
+/* idle OCV re-anchor: replaces vendor relax path that never fires under load */
+#define IDLE_CALIB_CUR_MAX		500	/* mA: only correct near rest */
+#define IDLE_CALIB_CNT			12	/* consecutive cycles (~1 min) */
+#define IDLE_CALIB_MIN_GAP		3	/* %: min soc drift to correct */
+
 enum work_mode {
 	MODE_ZERO = 0,
 	MODE_FINISH,
@@ -598,6 +603,7 @@
 	bool				is_first_on;
 	bool				is_force_calib;
 	int				last_dsoc;
+	int				idle_calib_cnt;
 	u8				cvtlmt_int_event;
 	u8				slp_dcdc_en_reg;
 	int				ocv_pre_dsoc;
@@ -2066,14 +2072,16 @@
 			val->intval = VIRTUAL_VOLTAGE * 1000;
 		break;
 	case POWER_SUPPLY_PROP_CAPACITY:
-		/*
-		val->intval = (battery->dsoc  + 500) / 1000;
+		/* report the coulomb SoC (rsoc): now kept accurate by the
+		 * measured ocv_table + idle OCV re-anchor, so no need for the
+		 * lossy/stale-prone dsoc smoothing layer */
+		val->intval = (battery->rsoc + 500) / 1000;
+		if (val->intval > 100)
+			val->intval = 100;
+		else if (val->intval < 0)
+			val->intval = 0;
 		if (battery->pdata->bat_mode == MODE_VIRTUAL)
 			val->intval = VIRTUAL_SOC;
-		*/
-		//dev_err(dev, "%d\n",battery->voltage_avg);
-		val->intval = rk817_battery_rg351p_capacity_get(battery->voltage_avg,rk817_bat_get_charge_state(battery));
-		
 		break;
 	case POWER_SUPPLY_PROP_HEALTH:
 		val->intval = POWER_SUPPLY_HEALTH_GOOD;
@@ -2088,7 +2096,7 @@
 	case POWER_SUPPLY_PROP_STATUS:
 		if (battery->pdata->bat_mode == MODE_VIRTUAL)
 			val->intval = VIRTUAL_STATUS;
-		else if (battery->dsoc == 100 * 1000)
+		else if (battery->rsoc >= 100 * 1000)
 			val->intval = POWER_SUPPLY_STATUS_FULL;
 		else {
 			if ((battery->chip_id != RK809_ID) &&
@@ -2128,16 +2136,18 @@
 	.get_property	= rk817_battery_get_property,
 };
 
-/* Coulomb-counter based SoC, kept in parallel to the voltage based capacity */
-static ssize_t capacity_coulomb_show(struct device *dev,
+/* Voltage-derived SoC, kept in parallel to the coulomb based capacity */
+static ssize_t capacity_voltage_show(struct device *dev,
 				     struct device_attribute *attr, char *buf)
 {
 	struct power_supply *psy = dev_get_drvdata(dev);
 	struct rk817_battery_device *battery = power_supply_get_drvdata(psy);
 
-	return sprintf(buf, "%d\n", (battery->dsoc + 500) / 1000);
+	return sprintf(buf, "%d\n",
+		       rk817_battery_rg351p_capacity_get(battery->voltage_avg,
+				rk817_bat_get_charge_state(battery)));
 }
-static DEVICE_ATTR_RO(capacity_coulomb);
+static DEVICE_ATTR_RO(capacity_voltage);
 
 static int rk817_bat_init_power_supply(struct rk817_battery_device *battery)
 {
@@ -2153,9 +2163,9 @@
 	}
 
 	ret = device_create_file(&battery->bat->dev,
-				 &dev_attr_capacity_coulomb);
+				 &dev_attr_capacity_voltage);
 	if (ret)
-		dev_err(battery->dev, "create capacity_coulomb attr failed\n");
+		dev_err(battery->dev, "create capacity_voltage attr failed\n");
 
 	return 0;
 }
@@ -2221,16 +2231,17 @@
 static void rk817_bat_power_supply_changed(struct rk817_battery_device *battery)
 {
 	static int old_soc = -1;
+	int soc = (battery->rsoc + 500) / 1000;
 
 	if (battery->dsoc > 100 * 1000)
 		battery->dsoc = 100 * 1000;
 	else if (battery->dsoc < 0)
 		battery->dsoc = 0;
 
-	if (battery->dsoc == old_soc)
+	if (soc == old_soc)
 		return;
 
-	old_soc = battery->dsoc;
+	old_soc = soc;
 	battery->last_dsoc = battery->dsoc;
 	power_supply_changed(battery->bat);
 	DBG("changed: dsoc=%d, rsoc=%d, v=%d, ov=%d c=%d, cap=%d, f=%d\n",
@@ -2868,6 +2879,40 @@
 	DBG("info END.\n");
 }
 
+static void rk817_bat_init_capacity(struct rk817_battery_device *battery,
+				    u32 cap);
+
+/*
+ * Re-anchor the coulomb SoC to the IR-compensated OCV whenever the load is low
+ * and steady. The vendor relax/sleep calibration never triggers here (the
+ * device rarely suspends), so the counter would otherwise drift freely.
+ */
+static void rk817_bat_idle_ocv_calib(struct rk817_battery_device *battery)
+{
+	int cur = battery->current_avg;
+	int ocv_vol, ocv_cap, ocv_soc;
+
+	if (battery->chrg_status == CHARGE_FINISH || cur >= 0 ||
+	    -cur > IDLE_CALIB_CUR_MAX) {
+		battery->idle_calib_cnt = 0;
+		return;
+	}
+	if (++battery->idle_calib_cnt < IDLE_CALIB_CNT)
+		return;
+	battery->idle_calib_cnt = 0;
+
+	ocv_vol = battery->voltage_avg + (-cur) * battery->bat_res / 1000;
+	ocv_soc = rk817_bat_vol_to_soc(battery, ocv_vol);
+	ocv_cap = rk817_bat_vol_to_cap(battery, ocv_vol);
+
+	if (abs(ocv_soc - battery->rsoc / 1000) < IDLE_CALIB_MIN_GAP)
+		return;
+
+	rk817_bat_init_capacity(battery, ocv_cap);
+	BAT_INFO("idle ocv calib: I=%d ocv=%d rsoc %d->%d%%\n",
+		 cur, ocv_vol, battery->rsoc / 1000, ocv_soc);
+}
+
 static void rk817_battery_work(struct work_struct *work)
 {
 	struct rk817_battery_device *battery =
@@ -2876,6 +2921,7 @@
 			     bat_delay_work.work);
 
 	rk817_bat_update_info(battery);
+	rk817_bat_idle_ocv_calib(battery);
 	rk817_bat_lowpwr_check(battery);
 	rk817_bat_display_smooth(battery);
 	rk817_bat_power_supply_changed(battery);
