 /**
+ * cfg80211_connect_bss - notify cfg80211 of connection result, with BSS entry
+ *
+ * @dev: network device
+ * @bssid: the BSSID of the AP
+ * @bss: cfg80211 bss entry for the connected AP (consumed one way or another,
+ *	even on error); may be %NULL to let cfg80211 look it up itself
+ * @req_ie: association request IEs (maybe be %NULL)
+ * @req_ie_len: association request IEs length
+ * @resp_ie: association response IEs (may be %NULL)
+ * @resp_ie_len: assoc response IEs length
+ * @status: status code, 0 for successful connection
+ * @gfp: allocation flags
+ *
+ * Like cfg80211_connect_result(), but lets the driver hand over the exact BSS
+ * entry so the cfg80211 core does not have to look it up (which can fail after
+ * a roam and trigger WARN_ON(!bss) in __cfg80211_connect_result()).
+ */
+void cfg80211_connect_bss(struct net_device *dev, const u8 *bssid,
+			  struct cfg80211_bss *bss, const u8 *req_ie,
+			  size_t req_ie_len, const u8 *resp_ie,
+			  size_t resp_ie_len, u16 status, gfp_t gfp);
