Wire the remaining VDPU2-capable codecs (MPEG-2, MPEG-4 part 2, H.263, MJPEG)
into ffmpeg's rkmpp decoder. The RK3326 VDPU2 block advertises these in MPP's
CAP_CODING_VDPU, so mpp_check_support_format() accepts them and they decode in
hardware (unlike VP9, which the SoC cannot do). Software decoders remain the
default; HW is only attempted for codecs listed in mpv's --hwdec-codecs, and MPP
init failure still falls back to software automatically.
--- a/libavcodec/rkmppdec.c
+++ b/libavcodec/rkmppdec.c
@@ -71,6 +71,10 @@
     case AV_CODEC_ID_HEVC:          return MPP_VIDEO_CodingHEVC;
     case AV_CODEC_ID_VP8:           return MPP_VIDEO_CodingVP8;
     case AV_CODEC_ID_VP9:           return MPP_VIDEO_CodingVP9;
+    case AV_CODEC_ID_MPEG2VIDEO:    return MPP_VIDEO_CodingMPEG2;
+    case AV_CODEC_ID_MPEG4:         return MPP_VIDEO_CodingMPEG4;
+    case AV_CODEC_ID_H263:          return MPP_VIDEO_CodingH263;
+    case AV_CODEC_ID_MJPEG:         return MPP_VIDEO_CodingMJPEG;
     default:                        return MPP_VIDEO_CodingUnused;
     }
 }
@@ -576,3 +580,7 @@
 RKMPP_DEC(hevc,  AV_CODEC_ID_HEVC,          "hevc_mp4toannexb")
 RKMPP_DEC(vp8,   AV_CODEC_ID_VP8,           NULL)
 RKMPP_DEC(vp9,   AV_CODEC_ID_VP9,           NULL)
+RKMPP_DEC(mpeg2, AV_CODEC_ID_MPEG2VIDEO,    NULL)
+RKMPP_DEC(mpeg4, AV_CODEC_ID_MPEG4,         NULL)
+RKMPP_DEC(h263,  AV_CODEC_ID_H263,          NULL)
+RKMPP_DEC(mjpeg, AV_CODEC_ID_MJPEG,         NULL)
