+static struct ra_ctx *drm_egl_signal_ctx;
+
+// Restore the pre-mpv CRTC even when killed (e.g. SIGTERM from a parent that
+// does not wait for our teardown), so the display is never left blanked.
+static void drm_egl_restore_and_die(int sig)
+{
+    struct ra_ctx *ctx = drm_egl_signal_ctx;
+    drm_egl_signal_ctx = NULL;
+    if (ctx) {
+        struct priv *p = ctx->priv;
+        crtc_release(ctx);
+        if (p->kms)
+            drmDropMaster(p->kms->fd);
+    }
+    struct sigaction sa = { .sa_handler = SIG_DFL };
+    sigemptyset(&sa.sa_mask);
+    sigaction(sig, &sa, NULL);
+    raise(sig);
+}
+
+static void drm_egl_install_signal_restore(struct ra_ctx *ctx)
+{
+    drm_egl_signal_ctx = ctx;
+    struct sigaction sa = { .sa_handler = drm_egl_restore_and_die };
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGTERM, &sa, NULL);
+    sigaction(SIGINT,  &sa, NULL);
+    sigaction(SIGHUP,  &sa, NULL);
+    sigaction(SIGQUIT, &sa, NULL);
+}
+
+static void drm_egl_remove_signal_restore(void)
+{
+    if (!drm_egl_signal_ctx)
+        return;
+    drm_egl_signal_ctx = NULL;
+    struct sigaction sa = { .sa_handler = SIG_DFL };
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGTERM, &sa, NULL);
+    sigaction(SIGINT,  &sa, NULL);
+    sigaction(SIGHUP,  &sa, NULL);
+    sigaction(SIGQUIT, &sa, NULL);
+}
+
 static void release_vt(void *data)
 {
