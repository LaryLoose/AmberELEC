+// Build controller bindings from the SDL GameController mapping (gamecontrollerdb), works for any mapped pad
+static SJoyBind JoyBindGameController[_BIND_ID_COUNT];
+static SJoyBind GCToBind(ZL_JoystickData* joy, SDL_GameControllerButtonBind_ZL b, signed char axisDir)
+{
+	SJoyBind r = { NULL, SJoyBind::FROM_NONE, 0, 0 };
+	switch (b.bindType)
+	{
+		case 1: r.Joy = joy; r.From = SJoyBind::FROM_BUTTON; r.Num = (unsigned char)b.value.button;    r.Dir = 0;                                  break; // SDL_CONTROLLER_BINDTYPE_BUTTON
+		case 2: r.Joy = joy; r.From = SJoyBind::FROM_AXIS;   r.Num = (unsigned char)b.value.axis;      r.Dir = axisDir;                            break; // SDL_CONTROLLER_BINDTYPE_AXIS
+		case 3: r.Joy = joy; r.From = SJoyBind::FROM_HAT;    r.Num = (unsigned char)b.value.hat.hat;   r.Dir = (signed char)b.value.hat.hat_mask;  break; // SDL_CONTROLLER_BINDTYPE_HAT (ZL_HAT_* == SDL_HAT_*)
+	}
+	return r;
+}
+static bool BuildBindsFromGameController(ZL_JoystickData* joy)
+{
+	static bool gcInit = false;
+	if (!gcInit)
+	{
+		gcInit = true;
+		SDL_InitSubSystem(0x00002000u); // SDL_INIT_GAMECONTROLLER
+		const char* db = getenv("SDL_GAMECONTROLLERCONFIG_FILE");
+		if (!db || !*db) db = "/storage/.config/SDL-GameControllerDB/gamecontrollerdb.txt";
+		SDL_GameControllerAddMappingsFromRW(SDL_RWFromFile(db, "rb"), 1);
+	}
+	int devidx = JoyDeviceIndex(joy);
+	if (devidx < 0 || !SDL_IsGameController(devidx)) return false;
+	struct _SDL_GameController* gc = SDL_GameControllerOpen(devidx);
+	if (!gc) return false;
+
+	SJoyBind* o = JoyBindGameController;
+	for (int i = 0; i != _BIND_ID_COUNT; i++) { o[i].Joy = NULL; o[i].From = SJoyBind::FROM_NONE; o[i].Num = 0; o[i].Dir = 0; }
+
+	// SDL_CONTROLLER_BUTTON_*: A=0 B=1 X=2 Y=3 BACK=4 GUIDE=5 START=6 LEFTSTICK=7 RIGHTSTICK=8 LEFTSHOULDER=9 RIGHTSHOULDER=10 DPAD_UP=11 DPAD_DOWN=12 DPAD_LEFT=13 DPAD_RIGHT=14
+	o[BIND_ID_UP]     = GCToBind(joy, SDL_GameControllerGetBindForButton(gc, 11), 1);
+	o[BIND_ID_DOWN]   = GCToBind(joy, SDL_GameControllerGetBindForButton(gc, 12), 1);
+	o[BIND_ID_LEFT]   = GCToBind(joy, SDL_GameControllerGetBindForButton(gc, 13), 1);
+	o[BIND_ID_RIGHT]  = GCToBind(joy, SDL_GameControllerGetBindForButton(gc, 14), 1);
+	o[BIND_ID_B]      = GCToBind(joy, SDL_GameControllerGetBindForButton(gc,  0), 1); // RetroPad B (bottom) = SDL A
+	o[BIND_ID_A]      = GCToBind(joy, SDL_GameControllerGetBindForButton(gc,  1), 1); // RetroPad A (right)  = SDL B
+	o[BIND_ID_Y]      = GCToBind(joy, SDL_GameControllerGetBindForButton(gc,  2), 1); // RetroPad Y (left)   = SDL X
+	o[BIND_ID_X]      = GCToBind(joy, SDL_GameControllerGetBindForButton(gc,  3), 1); // RetroPad X (top)    = SDL Y
+	o[BIND_ID_SELECT] = GCToBind(joy, SDL_GameControllerGetBindForButton(gc,  4), 1);
+	o[BIND_ID_START]  = GCToBind(joy, SDL_GameControllerGetBindForButton(gc,  6), 1);
+	o[BIND_ID_L]      = GCToBind(joy, SDL_GameControllerGetBindForButton(gc,  9), 1);
+	o[BIND_ID_R]      = GCToBind(joy, SDL_GameControllerGetBindForButton(gc, 10), 1);
+	o[BIND_ID_L3]     = GCToBind(joy, SDL_GameControllerGetBindForButton(gc,  7), 1);
+	o[BIND_ID_R3]     = GCToBind(joy, SDL_GameControllerGetBindForButton(gc,  8), 1);
+	// Triggers (SDL_CONTROLLER_AXIS_TRIGGERLEFT=4, TRIGGERRIGHT=5) may resolve to a button or an axis
+	o[BIND_ID_L2]     = GCToBind(joy, SDL_GameControllerGetBindForAxis(gc, 4), 1);
+	o[BIND_ID_R2]     = GCToBind(joy, SDL_GameControllerGetBindForAxis(gc, 5), 1);
+	// Analog sticks (SDL_CONTROLLER_AXIS_LEFTX=0 LEFTY=1 RIGHTX=2 RIGHTY=3) split into negative/positive directions
+	SDL_GameControllerButtonBind_ZL blx = SDL_GameControllerGetBindForAxis(gc, 0), bly = SDL_GameControllerGetBindForAxis(gc, 1);
+	SDL_GameControllerButtonBind_ZL brx = SDL_GameControllerGetBindForAxis(gc, 2), bry = SDL_GameControllerGetBindForAxis(gc, 3);
+	if (bly.bindType == 2) { o[BIND_ID_LSTICK_UP]   = GCToBind(joy, bly, -1); o[BIND_ID_LSTICK_DOWN]  = GCToBind(joy, bly, 1); }
+	if (blx.bindType == 2) { o[BIND_ID_LSTICK_LEFT] = GCToBind(joy, blx, -1); o[BIND_ID_LSTICK_RIGHT] = GCToBind(joy, blx, 1); }
+	if (bry.bindType == 2) { o[BIND_ID_RSTICK_UP]   = GCToBind(joy, bry, -1); o[BIND_ID_RSTICK_DOWN]  = GCToBind(joy, bry, 1); }
+	if (brx.bindType == 2) { o[BIND_ID_RSTICK_LEFT] = GCToBind(joy, brx, -1); o[BIND_ID_RSTICK_RIGHT] = GCToBind(joy, brx, 1); }
+
+	SDL_GameControllerClose(gc);
+	return true;
+}
