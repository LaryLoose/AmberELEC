+// Recursively scan a modifier list (including switched-on behaviors) for a cursor modifier.
+static bool mtropolisFindModifierCursor(const Common::Array<Common::SharedPtr<Modifier> > &modifiers, uint32 &outID) {
+	for (const Common::SharedPtr<Modifier> &m : modifiers) {
+		if (m->queryNavigationCursor(outID))
+			return true;
+		IModifierContainer *propagation = m->getMessagePropagationContainer();
+		if (propagation && mtropolisFindModifierCursor(propagation->getModifiers(), outID))
+			return true;
+	}
+	return false;
+}
+
+bool Runtime::triggerNavigationCursor(uint32 targetCursorID) {
+	Common::SharedPtr<Window> mainWindow = _mainWindow.lock();
+	if (!mainWindow)
+		return false;
+
+	Common::Array<ColliderInfo> colliders;
+	for (size_t i = 0; i < _sceneStack.size(); i++) {
+		Structural *scene = _sceneStack[i].scene.get();
+		if (scene)
+			recursiveFindColliders(scene, i, colliders, 0, 0, true);
+	}
+
+	// Sort ascending by layer/depth so the last match is the topmost zone.
+	Common::sort(colliders.begin(), colliders.end(), sortColliderPredicate);
+
+	const ColliderInfo *best = nullptr;
+	const int32 winW = mainWindow->getWidth();
+	const int32 winH = mainWindow->getHeight();
+	for (uint i = 0; i < colliders.size(); i++) {
+		const ColliderInfo &ci = colliders[i];
+		if (!isStructuralMouseInteractive(ci.element, kMouseInteractivityTestAnything))
+			continue;
+		// Only consider zones whose center is within the visible viewport;
+		// Obsidian keeps inactive zones for other view angles parked off-screen.
+		int32 zx = ci.absRect.left + ci.absRect.width() / 2;
+		int32 zy = ci.absRect.top + ci.absRect.height() / 2;
+		if (zx < 0 || zx >= winW || zy < 0 || zy >= winH)
+			continue;
+		uint32 cid = 0;
+		if (mtropolisFindModifierCursor(ci.element->getModifiers(), cid)) {
+			if (cid == targetCursorID)
+				best = &ci;
+		}
+	}
+
+	if (!best)
+		return false;
+
+	int32 cx = best->absRect.left + best->absRect.width() / 2 + mainWindow->getX();
+	int32 cy = best->absRect.top + best->absRect.height() / 2 + mainWindow->getY();
+
+	onMouseMove(cx, cy);
+	onMouseDown(cx, cy, Actions::kMouseButtonLeft);
+	onMouseUp(cx, cy, Actions::kMouseButtonLeft);
+	_system->warpMouse(cx, cy);
+	return true;
+}
