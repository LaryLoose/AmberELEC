 void set_game_speed(int new_fps) {
+	if (ConfMan.getActiveDomainName() == "nightmareframes") {
+		Common::String frameRate;
+		if (ConfMan.getActiveDomain()->tryGetVal("nightmare_frames_fps", frameRate)) {
+			const int selectedFrameRate = atoi(frameRate.c_str());
+			if (selectedFrameRate == 30 || selectedFrameRate == 40 || selectedFrameRate == 60)
+				new_fps = selectedFrameRate;
+		}
+	}
+
 	_G(frames_per_second) = new_fps;
 	if (!isTimerFpsMaxed()) // if in maxed mode, don't update timer for now
 		setTimerFps(new_fps);
