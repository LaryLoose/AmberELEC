+// NOTE: This file deliberately does NOT include any ScummVM headers.
+// common/scummsys.h pulls in common/forbidden.h, which #defines standard
+// symbols (time, clock, FILE, ...) to poison values and would break the
+// libstdc++/POSIX threading headers used here.
+
+#include "ags/lib/allegro/parallel.h"
+
+#include <pthread.h>
+#include <semaphore.h>
+#include <unistd.h>
+#include <atomic>
+#include <cstdlib>
+
+namespace AGS3 {
+namespace Parallel {
+
+namespace {
+
+class Pool {
+public:
+	Pool() {
+		long n = sysconf(_SC_NPROCESSORS_ONLN);
+		if (n < 1)
+			n = 1;
+		if (n > 8)
+			n = 8;
+		// Optional runtime override (e.g. AGS_BLIT_THREADS=1 disables threading).
+		if (const char *env = getenv("AGS_BLIT_THREADS")) {
+			long v = atol(env);
+			if (v >= 1 && v <= 8)
+				n = v;
+		}
+		_nthreads = (int)n;
+		sem_init(&_work, 0, 0);
+		sem_init(&_done, 0, 0);
+		_threads = nullptr;
+		if (_nthreads > 1) {
+			_threads = new pthread_t[_nthreads - 1];
+			for (int i = 0; i < _nthreads - 1; ++i)
+				pthread_create(&_threads[i], nullptr, &Pool::trampoline, this);
+		}
+	}
+
+	~Pool() {
+		_stop.store(true, std::memory_order_release);
+		for (int i = 0; i < _nthreads - 1; ++i)
+			sem_post(&_work);
+		for (int i = 0; i < _nthreads - 1; ++i)
+			pthread_join(_threads[i], nullptr);
+		delete[] _threads;
+		sem_destroy(&_work);
+		sem_destroy(&_done);
+	}
+
+	int numThreads() const { return _nthreads; }
+
+	void run(int total, int minChunk, BandFn fn, void *ctx) {
+		int nb = _nthreads;
+		if (minChunk > 0 && total / minChunk < nb)
+			nb = total / minChunk;
+		if (nb < 1)
+			nb = 1;
+		if (nb == 1) {
+			fn(0, total, ctx);
+			return;
+		}
+
+		_fn = fn;
+		_ctx = ctx;
+		_total = total;
+		_bands = nb;
+		_nextBand.store(0, std::memory_order_relaxed);
+
+		// Wake all workers; each grabs bands atomically and posts _done once.
+		for (int i = 0; i < _nthreads - 1; ++i)
+			sem_post(&_work);
+
+		// The calling thread participates too.
+		drain();
+
+		for (int i = 0; i < _nthreads - 1; ++i)
+			sem_wait(&_done);
+	}
+
+private:
+	static void *trampoline(void *p) {
+		static_cast<Pool *>(p)->worker();
+		return nullptr;
+	}
+
+	void range(int b, int &s, int &e) const {
+		const int base = _total / _bands;
+		const int extra = _total % _bands;
+		s = b * base + (b < extra ? b : extra);
+		e = s + base + (b < extra ? 1 : 0);
+	}
+
+	void drain() {
+		for (;;) {
+			const int b = _nextBand.fetch_add(1, std::memory_order_relaxed);
+			if (b >= _bands)
+				break;
+			int s, e;
+			range(b, s, e);
+			_fn(s, e, _ctx);
+		}
+	}
+
+	void worker() {
+		for (;;) {
+			sem_wait(&_work);
+			if (_stop.load(std::memory_order_acquire))
+				return;
+			drain();
+			sem_post(&_done);
+		}
+	}
+
+	int _nthreads = 1;
+	pthread_t *_threads = nullptr;
+	sem_t _work;
+	sem_t _done;
+
+	BandFn _fn = nullptr;
+	void *_ctx = nullptr;
+	int _total = 0;
+	int _bands = 0;
+	std::atomic<int> _nextBand{0};
+	std::atomic<bool> _stop{false};
+};
+
+Pool &pool() {
+	static Pool instance;
+	return instance;
+}
+
+} // namespace
+
+void forBands(int totalRows, int minRowsPerBand, BandFn fn, void *ctx) {
+	if (totalRows <= 0)
+		return;
+	pool().run(totalRows, minRowsPerBand, fn, ctx);
+}
+
+int numThreads() {
+	return pool().numThreads();
+}
+
+} // namespace Parallel
+} // namespace AGS3
