+
+// Minimal work-splitting helper backed by a persistent thread pool, used to
+// distribute independent scanline ranges of the software blitter across CPU
+// cores. Intentionally declares no system types so it can be included from
+// translation units where common/forbidden.h is active.
+
+#ifndef AGS_LIB_ALLEGRO_PARALLEL_H
+#define AGS_LIB_ALLEGRO_PARALLEL_H
+
+namespace AGS3 {
+namespace Parallel {
+
+// Processes the half-open row range [startRow, endRow) for one band.
+typedef void (*BandFn)(int startRow, int endRow, void *ctx);
+
+// Splits [0, totalRows) into up to numThreads() bands (each at least
+// minRowsPerBand rows) and runs fn on them across the pool, blocking until
+// all bands are done. Falls back to a direct call when splitting is not
+// worthwhile.
+void forBands(int totalRows, int minRowsPerBand, BandFn fn, void *ctx);
+
+// Number of participating threads (>= 1).
+int numThreads();
+
+} // namespace Parallel
+} // namespace AGS3
+
+#endif
