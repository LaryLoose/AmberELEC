+// Shared, read-only state for one non-scaled blit, passed to the per-band
+// worker so each scanline range can be rendered independently.
+struct DrawRowBandCtx {
+	BITMAP::DrawInnerArgs *args;
+	int destY0, yCtr0;
+	int xDir, xCtrStart, xCtrBppStart, xCtrWidth, secondToLast;
+	uint32x4_t tint, alphas, maskedAlphas, transColors;
+};
+
+// Renders one band of scanlines [startRow, endRow) of a non-scaled blit.
+// Each band writes disjoint destination rows, so bands run concurrently.
+template<int DestBytesPerPixel, int SrcBytesPerPixel>
+static void drawRowBand(int startRow, int endRow, void *ctxv) {
+	const DrawRowBandCtx &c = *static_cast<const DrawRowBandCtx *>(ctxv);
+	BITMAP::DrawInnerArgs &args = *c.args;
+	for (int r = startRow; r < endRow; ++r) {
+		const int myYCtr = c.yCtr0 + r;
+		byte *rowDestP = (byte *)args.destArea.getBasePtr(0, c.destY0 + r);
+		const byte *rowSrcP = (const byte *)args.src.getBasePtr(
+		                          args.horizFlip ? args.srcArea.right - 4 : args.srcArea.left,
+		                          args.vertFlip ? args.srcArea.bottom - 1 - myYCtr : args.srcArea.top + myYCtr);
+		int xCtr = c.xCtrStart, xCtrBpp = c.xCtrBppStart, destX = args.xStart;
+		for (; xCtr < c.secondToLast; destX += 4, xCtr += 4, xCtrBpp += SrcBytesPerPixel * 4) {
+			byte *destPtr = &rowDestP[destX * DestBytesPerPixel];
+			drawPixelSIMD<DestBytesPerPixel, SrcBytesPerPixel>(destPtr, rowSrcP, c.tint, c.alphas, c.maskedAlphas, c.transColors, c.xDir, xCtrBpp, args.srcAlpha, args.skipTrans, args.horizFlip, args.useTint, vmovq_n_u32(0));
+		}
+		byte *destPtr = &rowDestP[destX * DestBytesPerPixel];
+		uint32x4_t srcCols = vmovq_n_u32(0);
+		uint32x4_t destCols = vmovq_n_u32(0);
+		memcpy(&srcCols, rowSrcP + c.xDir * xCtrBpp, (c.xCtrWidth - xCtr) * SrcBytesPerPixel);
+		memcpy(&destCols, destPtr, (c.xCtrWidth - xCtr) * DestBytesPerPixel);
+		drawPixelSIMD<DestBytesPerPixel, SrcBytesPerPixel>((byte *)&destCols, (byte *)&srcCols, c.tint, c.alphas, c.maskedAlphas, c.transColors, c.xDir, 0, args.srcAlpha, args.skipTrans, args.horizFlip, args.useTint, vmovq_n_u32(0));
+		memcpy(destPtr, &destCols, (c.xCtrWidth - xCtr) * DestBytesPerPixel);
+	}
+}
