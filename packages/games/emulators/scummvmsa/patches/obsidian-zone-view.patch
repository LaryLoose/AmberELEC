+static void mtropolisBlitOverlayCursor(Graphics::Surface *screen, const Graphics::PixelFormat &fmt, Graphics::Surface *ov, int cxScreen, int cyScreen) {
+	if (!ov)
+		return;
+	const int w = ov->w;
+	const int h = ov->h;
+	const int left = cxScreen - w / 2;
+	const int top = cyScreen - h / 2;
+	for (int yy = 0; yy < h; yy++) {
+		const int sy = top + yy;
+		if (sy < 0 || sy >= screen->h)
+			continue;
+		const uint32 *srcRow = static_cast<const uint32 *>(ov->getBasePtr(0, yy));
+		for (int xx = 0; xx < w; xx++) {
+			const int sx = left + xx;
+			if (sx < 0 || sx >= screen->w)
+				continue;
+			uint8 a, r, g, b;
+			ov->format.colorToARGB(srcRow[xx], a, r, g, b);
+			if (a == 0)
+				continue;
+			byte *p = static_cast<byte *>(screen->getBasePtr(sx, sy));
+			uint32 dc = (fmt.bytesPerPixel == 2) ? *reinterpret_cast<uint16 *>(p) : *reinterpret_cast<uint32 *>(p);
+			uint8 dr, dg, db;
+			fmt.colorToRGB(dc, dr, dg, db);
+			if (a == 255) {
+				dr = r; dg = g; db = b;
+			} else {
+				dr = static_cast<uint8>((dr * (255 - a) + r * a) / 255);
+				dg = static_cast<uint8>((dg * (255 - a) + g * a) / 255);
+				db = static_cast<uint8>((db * (255 - a) + b * a) / 255);
+			}
+			const uint32 nc = fmt.RGBToColor(dr, dg, db);
+			if (fmt.bytesPerPixel == 2)
+				*reinterpret_cast<uint16 *>(p) = static_cast<uint16>(nc);
+			else
+				*reinterpret_cast<uint32 *>(p) = nc;
+		}
+	}
+}
