+// Builds (once per cursor ID) a small ARGB surface holding a 40%-opaque white backdrop
+// with the cursor composited on top, so the held overlay only needs a light alpha blit.
+static Graphics::Surface *mtropolisGetOverlayCursor(uint32 cid, Graphics::Cursor *cur) {
+	static Common::HashMap<uint32, Graphics::Surface *> s_cache;
+	Common::HashMap<uint32, Graphics::Surface *>::iterator it = s_cache.find(cid);
+	if (it != s_cache.end())
+		return it->_value;
+
+	Graphics::Surface *out = nullptr;
+	if (cur) {
+		const int cw = cur->getWidth();
+		const int ch = cur->getHeight();
+		const byte *px = cur->getSurface();
+		const byte *mask = cur->getMask();
+		const byte key = cur->getKeyColor();
+		const byte *pal = cur->getPalette();
+		const byte palStart = cur->getPaletteStartIndex();
+		const uint palCount = cur->getPaletteCount();
+
+		// Bounding box of opaque pixels: centers the visible glyph and skips empty cursors.
+		int minX = cw, minY = ch, maxX = -1, maxY = -1;
+		for (int yy = 0; yy < ch; yy++) {
+			for (int xx = 0; xx < cw; xx++) {
+				const int idx = px[yy * cw + xx];
+				const bool opaque = mask ? (mask[yy * cw + xx] != 0) : (static_cast<byte>(idx) != key);
+				if (!opaque)
+					continue;
+				if (xx < minX) minX = xx;
+				if (xx > maxX) maxX = xx;
+				if (yy < minY) minY = yy;
+				if (yy > maxY) maxY = yy;
+			}
+		}
+
+		if (maxX >= minX && maxY >= minY) {
+			const int margin = 8;
+			const int w = (maxX - minX + 1) + margin * 2;
+			const int h = (maxY - minY + 1) + margin * 2;
+			const Graphics::PixelFormat argb(4, 8, 8, 8, 8, 16, 8, 0, 24);
+			out = new Graphics::Surface();
+			out->create(w, h, argb);
+			out->fillRect(Common::Rect(0, 0, w, h), argb.ARGBToColor(190, 255, 255, 255));
+			for (int yy = minY; yy <= maxY; yy++) {
+				for (int xx = minX; xx <= maxX; xx++) {
+					const int idx = px[yy * cw + xx];
+					const bool opaque = mask ? (mask[yy * cw + xx] != 0) : (static_cast<byte>(idx) != key);
+					if (!opaque)
+						continue;
+					const uint pi = static_cast<uint>(idx - palStart);
+					if (pi >= palCount)
+						continue;
+					*static_cast<uint32 *>(out->getBasePtr(margin + (xx - minX), margin + (yy - minY))) = argb.ARGBToColor(255, pal[pi * 3 + 0], pal[pi * 3 + 1], pal[pi * 3 + 2]);
+				}
+			}
+		}
+	}
+	s_cache[cid] = out;
+	return out;
+}
