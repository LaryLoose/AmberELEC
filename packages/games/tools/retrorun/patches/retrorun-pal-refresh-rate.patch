+void go2_display_set_refresh_rate(go2_display_t *display, float fps)
+{
+    if (!display || fps < 1.0f)
+        return;
+
+    drmModeConnector *connector = drmModeGetConnector(display->fd, display->connector_id);
+    if (!connector)
+        return;
+
+    drmModeModeInfo *best = NULL;
+    float best_diff = 1000.0f;
+    for (int i = 0; i < connector->count_modes; i++)
+    {
+        drmModeModeInfo *m = &connector->modes[i];
+        if (m->hdisplay != display->mode.hdisplay || m->vdisplay != display->mode.vdisplay)
+            continue;
+        float diff = (float)m->vrefresh - fps;
+        if (diff < 0)
+            diff = -diff;
+        if (diff < best_diff)
+        {
+            best_diff = diff;
+            best = m;
+        }
+    }
+
+    // Only switch when we found a close match (<=1.5Hz) that differs from the current mode.
+    if (best && best_diff <= 1.5f && best->vrefresh != display->mode.vrefresh)
+    {
+        logger.log(Logger::DEB, "Switching display mode to %dx%d@%dHz for %.2f fps content",
+                   best->hdisplay, best->vdisplay, best->vrefresh, fps);
+        display->mode = *best;
+    }
+    else
+    {
+        logger.log(Logger::DEB, "Keeping display mode %dx%d@%dHz for %.2f fps content",
+                   display->mode.hdisplay, display->mode.vdisplay, display->mode.vrefresh, fps);
+    }
+
+    drmModeFreeConnector(connector);
+}
