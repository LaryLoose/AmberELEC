+
+static void osd_resolve(void) {
+  if (osd.ok)
+    return; // retry until the platform lib symbols become resolvable
+  osd.active       = (bool (*)(void)) dlsym(RTLD_DEFAULT, "osd_input_active");
+  osd.hold_begin   = (void (*)(void)) dlsym(RTLD_DEFAULT, "osd_hold_begin");
+  osd.hold_cancel  = (void (*)(void)) dlsym(RTLD_DEFAULT, "osd_hold_cancel");
+  osd.hold2_begin  = (void (*)(void)) dlsym(RTLD_DEFAULT, "osd_hold2_begin");
+  osd.hold2_cancel = (void (*)(void)) dlsym(RTLD_DEFAULT, "osd_hold2_cancel");
+  osd.nav      = (void (*)(int, int)) dlsym(RTLD_DEFAULT, "osd_nav");
+  osd.activate = (int  (*)(void)) dlsym(RTLD_DEFAULT, "osd_activate");
+  osd.back     = (void (*)(void)) dlsym(RTLD_DEFAULT, "osd_back");
+  osd.style_next = (void (*)(void)) dlsym(RTLD_DEFAULT, "osd_style_next");
+  osd.input_mode = (int (*)(void)) dlsym(RTLD_DEFAULT, "osd_input_mode");
+  osd.ok = osd.active && osd.hold_begin && osd.hold_cancel && osd.hold2_begin &&
+           osd.hold2_cancel && osd.nav && osd.activate && osd.back &&
+           osd.style_next && osd.input_mode;
+}
+
+static inline bool osd_menu_open(void) {
+  return osd.ok && osd.active();
+}
+
+// Bring this device's mouse emulation in line with the OSD-owned input mode.
+void *HandleMouseEmulation(void *param);
+static void reconcile_mouse(struct input_device *dev) {
+  if (!osd.ok || dev->controllerId < 0)
+    return;
+  bool want = osd.input_mode() != 0;
+  if (want == dev->mouseEmulation)
+    return;
+  dev->mouseEmulation = want;
+  if (want) {
+    pthread_create(&dev->meThread, NULL, HandleMouseEmulation, dev);
+  } else {
+    pthread_join(dev->meThread, NULL);
+    dev->meThread = 0;
+  }
+  // Release any held gamepad state on the host across the switch.
+  LiSendMultiControllerEvent(dev->controllerId, assignedControllerIds, 0, 0, 0, 0, 0, 0, 0);
+}
