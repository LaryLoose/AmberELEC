diff -ruN a/src/video/rk_osd.c b/src/video/rk_osd.c
--- a/src/video/rk_osd.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/video/rk_osd.c	2026-08-29 10:56:33.491950874 +0200
@@ -0,0 +1,491 @@
+/*
+ * On-screen display / overlay for the Rockchip (rk) hardware decoder.
+ * See rk_osd.h for the public interface.
+ *
+ * This is the orchestrator: it owns the render thread and the stats-bar
+ * visibility, and dispatches controller input to the menu / on-screen keyboard.
+ * The actual work is delegated to focused modules:
+ *   rk_osd_gfx   - drawing canvas + bitmap font
+ *   rk_osd_plane - double-buffered ARGB DRM overlay plane
+ *   rk_osd_hud   - stats bar
+ *   rk_osd_menu  - in-stream menu
+ *   rk_osk       - on-screen keyboard
+ */
+
+#include "rk_osd.h"
+#include "rk_osd_gfx.h"
+#include "rk_osd_plane.h"
+#include "rk_osd_hud.h"
+#include "rk_osd_menu.h"
+#include "rk_osd_icons.h"
+#include "rk_osk.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+#include <time.h>
+#include <unistd.h>
+
+// Select-hold timing: the closing ring appears after HOLD_DELAY_MS and then
+// closes over HOLD_RING_MS before the menu opens.
+#define HOLD_DELAY_MS 500
+#define HOLD_RING_MS  1000
+
+static osd_plane plane;
+static bool      osd_enabled;
+static bool      osd_visible;          // stats HUD bar (off until toggled)
+static int       input_mode;           // 0 = gamepad, 1 = mouse (OSD-owned)
+static volatile uint32_t frame_counter;
+static bool      quitappafter_set;     // host closes the app on exit regardless
+static bool      quit_app_requested;   // user chose to close the host app
+static bool      confirm_open;         // confirmation dialog visible
+static int       confirm_sel;          // 0 = Nein (default), 1 = Ja
+enum { CONFIRM_QUIT = 0, CONFIRM_ALTF4 = 1 };
+static int       confirm_kind;         // which action the dialog confirms
+
+// Closing-ring hold indicators: [0] = Select (open menu), [1] = Start (toggle input).
+static bool            hold_active[2];
+static struct timespec hold_start[2];
+
+static bool      osd_stop;
+static pthread_t osd_tid;
+// Lets the render thread sleep with zero CPU while nothing is shown.
+static pthread_mutex_t osd_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  osd_cv = PTHREAD_COND_INITIALIZER;
+
+static void osd_wake(void) {
+  pthread_mutex_lock(&osd_lock);
+  pthread_cond_signal(&osd_cv);
+  pthread_mutex_unlock(&osd_lock);
+}
+
+static bool anything_shown(void) {
+  return osd_visible || hold_active[0] || hold_active[1] ||
+         rk_menu_is_open() || rk_osk_is_open() || confirm_open;
+}
+
+static double ms_since(struct timespec *t0, struct timespec *now) {
+  return (now->tv_sec - t0->tv_sec) * 1000.0 +
+         (now->tv_nsec - t0->tv_nsec) / 1e6;
+}
+
+// Draw a closing-ring hold indicator: idx 0 = bottom-left (menu hint, three
+// dots), idx 1 = bottom-right (current input-mode icon).
+static void render_ring(int idx, float frac) {
+  int r_out = (gfx_w() >= 1280) ? 40 : 26;
+  int r_in = r_out - r_out / 4;
+  int margin = r_out + (gfx_w() >= 1280 ? 20 : 12);
+  int cx = (idx == 0) ? margin : gfx_w() - margin;
+  int cy = gfx_h() - margin;
+  gfx_fill_circle(cx, cy, r_in - 2, COL_PANEL);
+  gfx_ring(cx, cy, r_out, r_in, frac, 0x40FFFFFFu, COL_TITLE);
+  if (idx == 0) {
+    int s = r_out / 8;
+    if (s < 2) s = 2;
+    gfx_fill_rect(cx - 3 * s, cy - s / 2, s, s, COL_VALUE);
+    gfx_fill_rect(cx - s / 2, cy - s / 2, s, s, COL_VALUE);
+    gfx_fill_rect(cx + 2 * s, cy - s / 2, s, s, COL_VALUE);
+  } else {
+    // Show the target mode: the one that becomes active when the ring completes.
+    rk_menu_input_icon(cx, cy, (r_in * 2) / 3, COL_VALUE, COL_PANEL, !input_mode);
+  }
+}
+
+// Centered "quit moonlight?" dialog asking whether to also close the host app.
+static void render_confirm(void) {
+  const int W = gfx_w(), H = gfx_h();
+  const int h = (W >= 1280) ? 30 : 19;
+  const int line = h + h / 2;
+  const int pad = h;
+  int pw = W * 3 / 5;
+  if (pw < 240) pw = 240;
+  int ph = 2 * pad + 2 * line + line;
+  int px = (W - pw) / 2, py = (H - ph) / 2;
+  int rad = h, bw = (W >= 1280) ? 2 : 1;
+  gfx_fill_round_rect(px, py, pw, ph, rad, 0xFF66C0F4u);
+  gfx_fill_round_rect(px + bw, py + bw, pw - 2 * bw, ph - 2 * bw, rad - bw,
+                      0xFF141821u);
+
+  int cx = px + pw / 2, y = py + pad;
+  const char *t1 = (confirm_kind == CONFIRM_ALTF4) ? "Fenster schließen"
+                                                   : "Moonlight beenden";
+  gfx_draw_text_h(cx - gfx_text_width_h(t1, h) / 2, y, t1, h, COL_TITLE);
+  y += line;
+  const char *t2 = (confirm_kind == CONFIRM_ALTF4)
+                       ? "Aktives Fenster (Alt+F4)?"
+                       : "App auf dem Host schließen?";
+  gfx_draw_text_h(cx - gfx_text_width_h(t2, h) / 2, y, t2, h, COL_LABEL);
+  y += line + h / 2;
+
+  const char *lbl[2] = { "Nein", "Ja" };
+  int btw = pw / 3, bth = line, gap = pad;
+  int bx = cx - (2 * btw + gap) / 2;
+  for (int i = 0; i < 2; i++) {
+    bool sel = (i == confirm_sel);
+    int rx = bx + i * (btw + gap);
+    if (sel)
+      gfx_fill_round_rect(rx, y, btw, bth, bth / 4, 0xFF2E4E64u);
+    uint32_t col = sel ? COL_VALUE : COL_LABEL;
+    gfx_draw_text_h(rx + btw / 2 - gfx_text_width_h(lbl[i], h) / 2,
+                    y + (bth - h) / 2, lbl[i], h, col);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Render thread
+// ---------------------------------------------------------------------------
+static void *osd_thread(void *arg) {
+  (void)arg;
+  struct timespec last;
+  clock_gettime(CLOCK_MONOTONIC, &last);
+  uint32_t last_count = frame_counter;
+  int fps_shown = 0;
+  bool shown = false;
+
+  while (!osd_stop) {
+    // Sleep with zero CPU while nothing needs to be drawn.
+    pthread_mutex_lock(&osd_lock);
+    while (!osd_stop && !anything_shown()) {
+      if (shown) {
+        osd_plane_hide(&plane);
+        shown = false;
+      }
+      pthread_cond_wait(&osd_cv, &osd_lock);
+    }
+    pthread_mutex_unlock(&osd_lock);
+    if (osd_stop)
+      break;
+
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    double dt = (now.tv_sec - last.tv_sec) + (now.tv_nsec - last.tv_nsec) / 1e9;
+    uint32_t cur = frame_counter;
+    // Recompute FPS over a ~400ms window so it stays stable even when the menu
+    // forces frequent redraws.
+    if (dt >= 0.4) {
+      fps_shown = (dt < 2.0) ? (int)((cur - last_count) / dt + 0.5) : 0;
+      last = now;
+      last_count = cur;
+    }
+    int fps = fps_shown;
+
+    // Hold rings: after an initial delay each closing ring appears; on
+    // completion [0] opens the menu, [1] toggles the input mode.
+    float rfrac[2] = { -1.0f, -1.0f };
+    for (int k = 0; k < 2; k++) {
+      if (!hold_active[k])
+        continue;
+      double e = ms_since(&hold_start[k], &now);
+      if (e < HOLD_DELAY_MS)
+        continue;
+      float f = (float)((e - HOLD_DELAY_MS) / HOLD_RING_MS);
+      if (f >= 1.0f) {
+        hold_active[k] = false;
+        if (k == 0) rk_menu_open();
+        else        input_mode ^= 1;
+      } else {
+        rfrac[k] = f;
+      }
+    }
+
+    uint8_t *buf = osd_plane_back(&plane);
+    gfx_set_target(buf, plane.pitch, plane.w, plane.h);
+    memset(buf, 0, plane.size);
+    if (osd_visible)
+      rk_hud_render(fps);
+    if (rk_menu_is_open())
+      rk_menu_render(osd_visible, input_mode);
+    if (rk_osk_is_open())
+      rk_osk_render();
+    if (confirm_open)
+      render_confirm();
+    for (int k = 0; k < 2; k++)
+      if (rfrac[k] >= 0.0f)
+        render_ring(k, rfrac[k]);
+    osd_plane_present(&plane);
+    shown = true;
+
+    // Smooth while a ring animates, snappy in a modal, relaxed otherwise.
+    bool ring_anim = rfrac[0] >= 0.0f || rfrac[1] >= 0.0f;
+    bool holding = hold_active[0] || hold_active[1];
+    bool modal = rk_menu_is_open() || rk_osk_is_open();
+    int sleep_ms = ring_anim ? 24 : holding ? 100 : modal ? 60 : 400;
+    usleep(sleep_ms * 1000);
+  }
+
+  osd_plane_hide(&plane);
+  return NULL;
+}
+
+// ---------------------------------------------------------------------------
+// Persisted settings (icon style) in moonlight.conf
+// ---------------------------------------------------------------------------
+static void osd_config_path(char *buf, size_t n) {
+  const char *home = getenv("HOME");
+  if (!home || !home[0])
+    home = "/storage";
+  snprintf(buf, n, "%s/.config/moonlight/moonlight.conf", home);
+}
+
+static void osd_load_style(void) {
+  char path[256];
+  osd_config_path(path, sizeof path);
+  FILE *f = fopen(path, "r");
+  if (!f)
+    return;
+  char line[256];
+  int v;
+  while (fgets(line, sizeof line, f))
+    if (sscanf(line, " osdstyle = %d", &v) == 1) {
+      icons_set_style(v);
+      break;
+    }
+  fclose(f);
+}
+
+// Rewrite moonlight.conf, updating (or appending) the osdstyle line and
+// preserving all other lines/comments.
+static void osd_save_style(void) {
+  char path[256];
+  osd_config_path(path, sizeof path);
+  static char lines[64][256];
+  int n = 0, found = -1, v;
+  FILE *f = fopen(path, "r");
+  if (f) {
+    while (n < 64 && fgets(lines[n], sizeof lines[n], f)) {
+      if (sscanf(lines[n], " osdstyle = %d", &v) == 1)
+        found = n;
+      n++;
+    }
+    fclose(f);
+  }
+  char entry[64];
+  snprintf(entry, sizeof entry, "osdstyle = %d\n", icons_get_style());
+  if (found >= 0)
+    snprintf(lines[found], sizeof lines[found], "%s", entry);
+  f = fopen(path, "w");
+  if (!f)
+    return;
+  for (int i = 0; i < n; i++)
+    fputs(lines[i], f);
+  if (found < 0)
+    fputs(entry, f);
+  fclose(f);
+}
+
+// ---------------------------------------------------------------------------
+// Lifecycle
+// ---------------------------------------------------------------------------
+int osd_init(int drm_fd, uint32_t crtc_id, uint32_t crtc_bit,
+             int crtc_w, int crtc_h, uint32_t video_plane_id) {
+  if (!osd_plane_init(&plane, drm_fd, crtc_id, crtc_bit, crtc_w, crtc_h,
+                      video_plane_id)) {
+    fprintf(stderr, "OSD: no free ARGB overlay plane available; HUD disabled\n");
+    return -1;
+  }
+
+  osd_load_style();
+  osd_stop = false;
+  if (pthread_create(&osd_tid, NULL, osd_thread, NULL)) {
+    perror("OSD pthread_create");
+    osd_plane_destroy(&plane);
+    return -1;
+  }
+
+  osd_enabled = true;
+  fprintf(stderr, "OSD: HUD active on plane %u (%dx%d)\n", plane.plane_id,
+          crtc_w, crtc_h);
+  return 0;
+}
+
+void osd_cleanup(void) {
+  if (!osd_enabled)
+    return;
+  osd_enabled = false;
+
+  osd_stop = true;
+  osd_wake();
+  pthread_join(osd_tid, NULL);
+
+  osd_plane_hide(&plane);
+  osd_plane_destroy(&plane);
+}
+
+// ---------------------------------------------------------------------------
+// State updates
+// ---------------------------------------------------------------------------
+void osd_set_stream_info(int video_format, int width, int height) {
+  rk_hud_set_stream_info(video_format, width, height);
+}
+
+void osd_set_app_name(const char *name) {
+  rk_hud_set_app_name(name);
+}
+
+void osd_set_quitappafter(bool on) {
+  quitappafter_set = on;
+}
+
+bool osd_should_quit_app(void) {
+  return quit_app_requested;
+}
+
+void osd_notify_frame(void) {
+  frame_counter++;
+}
+
+void osd_notify_bytes(unsigned bytes) {
+  rk_hud_add_video_bytes(bytes);
+}
+
+int osd_input_mode(void) {
+  return input_mode;
+}
+
+void osd_set_visible(bool visible) {
+  osd_visible = visible;
+  osd_wake();
+}
+
+void osd_toggle(void) {
+  osd_visible = !osd_visible;
+  osd_wake();
+}
+
+// ---------------------------------------------------------------------------
+// Input dispatch (menu + OSK)
+// ---------------------------------------------------------------------------
+bool osd_input_active(void) {
+  return rk_menu_is_open() || rk_osk_is_open() || confirm_open;
+}
+
+void osd_hold_begin(void) {
+  // If a modal is already open, Select closes it instead of arming the ring.
+  if (rk_menu_is_open() || rk_osk_is_open() || confirm_open) {
+    rk_osk_alt_tab_commit();
+    confirm_open = false;
+    rk_menu_close();
+    rk_osk_close();
+  } else {
+    clock_gettime(CLOCK_MONOTONIC, &hold_start[0]);
+    hold_active[0] = true;
+  }
+  osd_wake();
+}
+
+void osd_hold_cancel(void) {
+  hold_active[0] = false; // no-op if the ring already completed and opened the menu
+  osd_wake();
+}
+
+void osd_hold2_begin(void) {
+  // Ignore Start-hold while a modal is open (Start is not used there).
+  if (rk_menu_is_open() || rk_osk_is_open())
+    return;
+  clock_gettime(CLOCK_MONOTONIC, &hold_start[1]);
+  hold_active[1] = true;
+  osd_wake();
+}
+
+void osd_hold2_cancel(void) {
+  hold_active[1] = false;
+  osd_wake();
+}
+
+void osd_nav(int dx, int dy) {
+  if (confirm_open) {
+    if (dx > 0) confirm_sel = 1;
+    else if (dx < 0) confirm_sel = 0;
+    osd_wake();
+    return;
+  }
+  if (rk_osk_is_open())
+    rk_osk_nav(dx, dy);
+  else if (rk_osk_alt_tab_held()) {
+    if (dx)
+      rk_osk_alt_tab_step(dx > 0); // right = next window, left = previous
+  } else
+    rk_menu_move(dx);
+  osd_wake();
+}
+
+int osd_activate(void) {
+  if (confirm_open) {
+    bool yes = (confirm_sel == 1);
+    int kind = confirm_kind;
+    confirm_open = false;
+    osd_wake();
+    if (kind == CONFIRM_ALTF4) {
+      if (yes) rk_osk_send_alt_f4(); // close the host window, stay connected
+      return OSD_ACT_NONE;
+    }
+    quit_app_requested = yes;
+    return OSD_ACT_QUIT; // disconnect; main closes the app if requested
+  }
+  if (rk_osk_is_open()) {
+    rk_osk_press();
+    osd_wake();
+    return OSD_ACT_NONE;
+  }
+
+  int action = rk_menu_activate();
+  if (action != OSD_ACT_ALTTAB)
+    rk_osk_alt_tab_commit(); // leaving the switcher selects the window
+  switch (action) {
+  case OSD_ACT_TOGGLE_STATS:
+    osd_visible = !osd_visible;
+    action = OSD_ACT_NONE;
+    break;
+  case OSD_ACT_TOGGLE_INPUT:
+    input_mode ^= 1;
+    action = OSD_ACT_NONE;
+    break;
+  case OSD_ACT_OSK:
+    rk_menu_close();
+    rk_osk_open();
+    action = OSD_ACT_NONE;
+    break;
+  case OSD_ACT_ALTTAB:
+    rk_osk_alt_tab_step(true); // hold Alt (first press) and Tab to next window
+    action = OSD_ACT_NONE;
+    break;
+  case OSD_ACT_ALTF4:
+    rk_menu_close();
+    confirm_open = true;
+    confirm_kind = CONFIRM_ALTF4;
+    confirm_sel = 0;
+    action = OSD_ACT_NONE;
+    break;
+  case OSD_ACT_QUIT:
+    if (!quitappafter_set) {
+      // Ask whether to also close the app on the host (default: No).
+      rk_menu_close();
+      confirm_open = true;
+      confirm_kind = CONFIRM_QUIT;
+      confirm_sel = 0;
+      action = OSD_ACT_NONE;
+    }
+    break;
+  }
+  osd_wake();
+  return action; // QUIT propagates to the input layer
+}
+
+void osd_back(void) {
+  if (confirm_open)
+    confirm_open = false;
+  else if (rk_osk_is_open())
+    rk_osk_close();
+  else if (rk_osk_alt_tab_held())
+    rk_osk_alt_tab_commit(); // release Alt, keep the menu open
+  else
+    rk_menu_close();
+  osd_wake();
+}
+
+void osd_style_next(void) {
+  icons_set_style(icons_get_style() + 1);
+  osd_save_style();
+  osd_wake();
+}
diff -ruN a/src/video/rk_osd.h b/src/video/rk_osd.h
--- a/src/video/rk_osd.h	1970-01-01 01:00:00.000000000 +0100
+++ b/src/video/rk_osd.h	2026-08-29 10:56:33.492253366 +0200
@@ -0,0 +1,83 @@
+/*
+ * On-screen display / overlay for the Rockchip (rk) hardware decoder.
+ *
+ * Renders a HUD onto a second ARGB8888 DRM plane composited by the VOP in
+ * hardware above the zero-copy NV12 video plane. Self-contained: if no free
+ * overlay plane is available, the OSD stays disabled and streaming continues.
+ */
+
+#ifndef RK_OSD_H
+#define RK_OSD_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+// Initialize the OSD on a second free ARGB plane above the video plane.
+// Returns 0 on success, negative if no suitable plane is available.
+int osd_init(int drm_fd, uint32_t crtc_id, uint32_t crtc_bit,
+             int crtc_w, int crtc_h, uint32_t video_plane_id);
+
+// Provide static stream info shown in the HUD.
+void osd_set_stream_info(int video_format, int width, int height);
+
+// Name of the streamed app/profile shown in the HUD (e.g. "Desktop").
+void osd_set_app_name(const char *name);
+
+// Whether the host closes the app on exit anyway (skips the quit dialog).
+void osd_set_quitappafter(bool on);
+
+// True if the user chose "close app on host" in the quit dialog.
+bool osd_should_quit_app(void);
+
+// Current input mode owned by the OSD (0 = gamepad, 1 = mouse). The input layer
+// reconciles its mouse emulation to this value.
+int osd_input_mode(void);
+
+// Called once per displayed video frame to drive the local FPS counter.
+void osd_notify_frame(void);
+
+// Feed the size of a received video frame for the HUD's actual-bitrate calc.
+void osd_notify_bytes(unsigned bytes);
+
+// Show/hide the stats HUD bar.
+void osd_toggle(void);
+void osd_set_visible(bool visible);
+
+// ---------------------------------------------------------------------------
+// In-stream menu (Steam-Link style). Driven from the input layer via dlsym;
+// while the menu is open the input layer suppresses controller events to the
+// host so navigation only drives the OSD.
+// ---------------------------------------------------------------------------
+
+// Action codes returned by the menu. Codes the input layer must carry out
+// (QUIT, TOGGLE_INPUT) are propagated by osd_activate(); the rest are handled
+// inside the OSD and reported back as OSD_ACT_NONE.
+enum {
+  OSD_ACT_NONE         = 0,
+  OSD_ACT_QUIT         = 1, // disconnect
+  OSD_ACT_TOGGLE_INPUT = 2, // gamepad <-> mouse emulation
+  OSD_ACT_OSK          = 3, // open the on-screen keyboard
+  OSD_ACT_TOGGLE_STATS = 4, // show/hide the stats HUD bar
+  OSD_ACT_ALTTAB       = 5, // send Alt+Tab to the host (switch windows)
+  OSD_ACT_ALTF4        = 6, // send Alt+F4 to the host (close window)
+};
+
+bool osd_input_active(void);     // menu or OSK currently capturing input
+// Select-hold: begin shows a closing-ring indicator; when it completes the
+// menu opens immediately (mid-hold). Cancel aborts if released early. If a
+// modal is already open, begin closes it instead.
+void osd_hold_begin(void);
+void osd_hold_cancel(void);
+// Start-hold: same closing-ring, bottom-right, toggles the input mode on
+// completion.
+void osd_hold2_begin(void);
+void osd_hold2_cancel(void);
+void osd_nav(int dx, int dy);    // DPAD navigation (dx/dy in {-1,0,+1})
+int  osd_activate(void);         // A: act on focus, return action code
+void osd_back(void);             // B: close current modal
+void osd_style_next(void);       // Start (in menu): cycle the icon style
+
+// Tear down the OSD (stops the render thread and releases DRM resources).
+void osd_cleanup(void);
+
+#endif
diff -ruN a/src/video/rk_osd_gfx.c b/src/video/rk_osd_gfx.c
--- a/src/video/rk_osd_gfx.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/video/rk_osd_gfx.c	2026-08-29 10:56:33.492438161 +0200
@@ -0,0 +1,278 @@
+/*
+ * Software drawing canvas + TrueType text for the rk OSD overlay.
+ * See rk_osd_gfx.h.
+ */
+
+#include "rk_osd_gfx.h"
+
+#include <string.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define STB_TRUETYPE_IMPLEMENTATION
+#include "stb_truetype.h"
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+static uint8_t *gfx_ptr;
+static uint32_t gfx_pitch;
+static int      gfx_width, gfx_height;
+
+void gfx_set_target(uint8_t *ptr, uint32_t pitch, int w, int h) {
+  gfx_ptr = ptr;
+  gfx_pitch = pitch;
+  gfx_width = w;
+  gfx_height = h;
+}
+
+int gfx_w(void) { return gfx_width; }
+int gfx_h(void) { return gfx_height; }
+
+void gfx_fill_rect(int x, int y, int w, int h, uint32_t argb) {
+  // Clamp to the canvas once instead of bounds-checking every pixel.
+  int x0 = x < 0 ? 0 : x;
+  int y0 = y < 0 ? 0 : y;
+  int x1 = x + w, y1 = y + h;
+  if (x1 > gfx_width)  x1 = gfx_width;
+  if (y1 > gfx_height) y1 = gfx_height;
+  for (int j = y0; j < y1; j++) {
+    uint32_t *row = (uint32_t *)(gfx_ptr + j * gfx_pitch) + x0;
+    for (int i = x0; i < x1; i++)
+      *row++ = argb;
+  }
+}
+
+void gfx_put_px(int x, int y, uint32_t argb) {
+  if (x < 0 || y < 0 || x >= gfx_width || y >= gfx_height)
+    return;
+  *(uint32_t *)(gfx_ptr + y * gfx_pitch + x * 4) = argb;
+}
+
+void gfx_blend_px(int x, int y, uint32_t argb) {
+  if (x < 0 || y < 0 || x >= gfx_width || y >= gfx_height)
+    return;
+  uint32_t sa = (argb >> 24) & 0xFF;
+  if (sa == 0)
+    return;
+  uint32_t *p = (uint32_t *)(gfx_ptr + y * gfx_pitch + x * 4);
+  if (sa == 255) {
+    *p = argb;
+    return;
+  }
+  uint32_t d = *p, da = (d >> 24) & 0xFF;
+  uint32_t sr = (argb >> 16) & 0xFF, sg = (argb >> 8) & 0xFF, sb = argb & 0xFF;
+  uint32_t dr = (d >> 16) & 0xFF, dg = (d >> 8) & 0xFF, db = d & 0xFF;
+  uint32_t inv = 255 - sa;
+  uint32_t oa = sa + da * inv / 255;
+  if (oa == 0) {
+    *p = 0;
+    return;
+  }
+  uint32_t r = (sr * sa + dr * da * inv / 255) / oa;
+  uint32_t g = (sg * sa + dg * da * inv / 255) / oa;
+  uint32_t b = (sb * sa + db * da * inv / 255) / oa;
+  *p = (oa << 24) | (r << 16) | (g << 8) | b;
+}
+
+void gfx_fill_circle(int cx, int cy, int r, uint32_t argb) {
+  int r2 = r * r;
+  for (int dy = -r; dy <= r; dy++) {
+    int dx = (int)(sqrtf((float)(r2 - dy * dy)) + 0.5f);
+    gfx_fill_rect(cx - dx, cy + dy, 2 * dx + 1, 1, argb);
+  }
+}
+
+void gfx_fill_round_rect(int x, int y, int w, int h, int r, uint32_t argb) {
+  if (r * 2 > w) r = w / 2;
+  if (r * 2 > h) r = h / 2;
+  gfx_fill_rect(x + r, y, w - 2 * r, h, argb);           // center band
+  gfx_fill_rect(x, y + r, r, h - 2 * r, argb);           // left
+  gfx_fill_rect(x + w - r, y + r, r, h - 2 * r, argb);   // right
+  gfx_fill_circle(x + r, y + r, r, argb);
+  gfx_fill_circle(x + w - r - 1, y + r, r, argb);
+  gfx_fill_circle(x + r, y + h - r - 1, r, argb);
+  gfx_fill_circle(x + w - r - 1, y + h - r - 1, r, argb);
+}
+
+void gfx_blend_circle(int cx, int cy, int r, uint32_t argb) {
+  int r2 = r * r;
+  for (int dy = -r; dy <= r; dy++) {
+    int dx = (int)(sqrtf((float)(r2 - dy * dy)) + 0.5f);
+    for (int x = cx - dx; x <= cx + dx; x++)
+      gfx_blend_px(x, cy + dy, argb);
+  }
+}
+
+void gfx_ring(int cx, int cy, int r_out, int r_in, float frac,
+              uint32_t track, uint32_t fill) {
+  if (frac < 0) frac = 0;
+  if (frac > 1) frac = 1;
+  int ro2 = r_out * r_out, ri2 = r_in * r_in;
+  for (int y = -r_out; y <= r_out; y++) {
+    for (int x = -r_out; x <= r_out; x++) {
+      int d2 = x * x + y * y;
+      if (d2 > ro2 || d2 < ri2)
+        continue;
+      // Angle from 12 o'clock, clockwise, normalized to [0,1).
+      float a = atan2f((float)x, (float)-y) / (2.0f * (float)M_PI);
+      if (a < 0) a += 1.0f;
+      gfx_put_px(cx + x, cy + y, a <= frac ? fill : track);
+    }
+  }
+}
+
+// Horizontal glyph scale (percent of the cell height) for the TTF text below.
+static int text_condense = 100;
+
+void gfx_set_text_condense(int percent) {
+  if (percent < 25) percent = 25;
+  if (percent > 100) percent = 100;
+  text_condense = percent;
+}
+
+// ---------------------------------------------------------------------------
+// TrueType text (stb_truetype), loaded from a system font. Renders nothing if
+// no TTF can be loaded.
+// ---------------------------------------------------------------------------
+static stbtt_fontinfo ttf;
+static unsigned char  *ttf_buf;
+static int             ttf_state; // 0 = untried, 1 = ready, -1 = unavailable
+
+static int ensure_ttf(void) {
+  if (ttf_state)
+    return ttf_state > 0;
+  ttf_state = -1;
+  static const char *paths[] = {
+    "/usr/share/fonts/liberation/LiberationSans-Bold.ttf",
+    "/usr/share/fonts/liberation/LiberationSans-Regular.ttf",
+    "/storage/.config/emulationstation/resources/NotoSans-Regular.ttf",
+    NULL
+  };
+  for (int i = 0; paths[i]; i++) {
+    FILE *f = fopen(paths[i], "rb");
+    if (!f)
+      continue;
+    fseek(f, 0, SEEK_END);
+    long n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (n <= 0) { fclose(f); continue; }
+    ttf_buf = malloc((size_t)n);
+    if (!ttf_buf) { fclose(f); continue; }
+    size_t rd = fread(ttf_buf, 1, (size_t)n, f);
+    fclose(f);
+    if (rd != (size_t)n ||
+        !stbtt_InitFont(&ttf, ttf_buf, stbtt_GetFontOffsetForIndex(ttf_buf, 0))) {
+      free(ttf_buf);
+      ttf_buf = NULL;
+      continue;
+    }
+    ttf_state = 1;
+    break;
+  }
+  return ttf_state > 0;
+}
+
+// Minimal UTF-8 decode; advances past one code point.
+static const char *utf8_next(const char *s, unsigned *cp) {
+  unsigned char c = (unsigned char)s[0];
+  if (c < 0x80) { *cp = c; return s + 1; }
+  if ((c >> 5) == 0x6 && s[1]) {
+    *cp = ((c & 0x1F) << 6) | (s[1] & 0x3F);
+    return s + 2;
+  }
+  if ((c >> 4) == 0xE && s[1] && s[2]) {
+    *cp = ((c & 0x0F) << 12) | ((s[1] & 0x3F) << 6) | (s[2] & 0x3F);
+    return s + 3;
+  }
+  if ((c >> 3) == 0x1E && s[1] && s[2] && s[3]) {
+    *cp = ((c & 0x07) << 18) | ((s[1] & 0x3F) << 12) | ((s[2] & 0x3F) << 6) |
+          (s[3] & 0x3F);
+    return s + 4;
+  }
+  *cp = c;
+  return s + 1;
+}
+
+// Rasterized-glyph cache keyed by (codepoint, pixel height, condense).
+struct gcache {
+  int cp, px, cond, used;
+  int w, h, xoff, yoff, adv;
+  unsigned char *bmp;
+};
+#define GCACHE_N 224
+static struct gcache gcache[GCACHE_N];
+static int gcache_rr;
+
+static struct gcache *ttf_glyph(unsigned cp, int px, int cond) {
+  for (int i = 0; i < GCACHE_N; i++)
+    if (gcache[i].used && gcache[i].cp == (int)cp && gcache[i].px == px &&
+        gcache[i].cond == cond)
+      return &gcache[i];
+
+  struct gcache *g = &gcache[gcache_rr];
+  gcache_rr = (gcache_rr + 1) % GCACHE_N;
+  if (g->bmp) { stbtt_FreeBitmap(g->bmp, NULL); g->bmp = NULL; }
+
+  float sy = stbtt_ScaleForPixelHeight(&ttf, (float)px);
+  float sx = sy * (float)cond / 100.0f;
+  int adv, lsb;
+  stbtt_GetCodepointHMetrics(&ttf, (int)cp, &adv, &lsb);
+  g->cp = (int)cp; g->px = px; g->cond = cond; g->used = 1;
+  g->adv = (int)(adv * sx + 0.5f);
+  g->bmp = stbtt_GetCodepointBitmap(&ttf, sx, sy, (int)cp, &g->w, &g->h,
+                                    &g->xoff, &g->yoff);
+  return g;
+}
+
+static int ttf_width(const char *s, int px) {
+  int w = 0;
+  unsigned cp;
+  for (const char *p = s; *p; ) {
+    p = utf8_next(p, &cp);
+    w += ttf_glyph(cp, px, text_condense)->adv;
+  }
+  return w;
+}
+
+static int ttf_draw(int x, int y, const char *s, int px, uint32_t argb) {
+  int asc, desc, lg;
+  stbtt_GetFontVMetrics(&ttf, &asc, &desc, &lg);
+  float sy = stbtt_ScaleForPixelHeight(&ttf, (float)px);
+  int baseline = (int)(asc * sy + 0.5f);
+  uint32_t cr = (argb >> 16) & 0xFF, cg = (argb >> 8) & 0xFF, cb = argb & 0xFF;
+  uint32_t ca = (argb >> 24) & 0xFF;
+  int x0 = x;
+  unsigned cp;
+  for (const char *p = s; *p; ) {
+    p = utf8_next(p, &cp);
+    struct gcache *g = ttf_glyph(cp, px, text_condense);
+    if (g->bmp) {
+      for (int j = 0; j < g->h; j++) {
+        int yy = y + baseline + g->yoff + j;
+        const unsigned char *row = g->bmp + j * g->w;
+        for (int i = 0; i < g->w; i++) {
+          unsigned cov = row[i];
+          if (!cov)
+            continue;
+          uint32_t aa = ca * cov / 255;
+          gfx_blend_px(x + g->xoff + i, yy, (aa << 24) | (cr << 16) | (cg << 8) | cb);
+        }
+      }
+    }
+    x += g->adv;
+  }
+  return x - x0;
+}
+
+int gfx_text_width_h(const char *s, int h) {
+  if (h < 4) h = 4;
+  return ensure_ttf() ? ttf_width(s, h) : 0;
+}
+
+int gfx_draw_text_h(int x, int y, const char *s, int h, uint32_t argb) {
+  if (h < 4) h = 4;
+  return ensure_ttf() ? ttf_draw(x, y, s, h, argb) : 0;
+}
diff -ruN a/src/video/rk_osd_gfx.h b/src/video/rk_osd_gfx.h
--- a/src/video/rk_osd_gfx.h	1970-01-01 01:00:00.000000000 +0100
+++ b/src/video/rk_osd_gfx.h	2026-08-29 10:56:33.492616856 +0200
@@ -0,0 +1,49 @@
+/*
+ * Minimal software drawing canvas for the rk OSD overlay.
+ *
+ * Owns the current draw target (a CPU-mapped ARGB8888 buffer) plus the TTF
+ * text renderer and primitives. Shared by the HUD/menu (rk_osd.c) and the
+ * on-screen keyboard (rk_osk.c).
+ */
+
+#ifndef RK_OSD_GFX_H
+#define RK_OSD_GFX_H
+
+#include <stdint.h>
+
+// Steam-Link-ish palette (ARGB, 0xAARRGGBB).
+#define COL_PANEL   0xC0141821u  // translucent dark slate
+#define COL_TITLE   0xFF66C0F4u  // steam blue
+#define COL_LABEL   0xFF9AA6B2u  // muted grey
+#define COL_VALUE   0xFFFFFFFFu  // white
+#define COL_GOOD    0xFF6FD08Cu  // green
+#define COL_WARN    0xFFE6C84Bu  // amber
+#define COL_BAD     0xFFE65B5Bu  // red
+#define COL_CLEAR   0x00000000u
+
+// Point the canvas at the buffer to draw into for the current frame.
+void gfx_set_target(uint8_t *ptr, uint32_t pitch, int w, int h);
+
+int gfx_w(void);
+int gfx_h(void);
+
+void gfx_fill_rect(int x, int y, int w, int h, uint32_t argb);
+void gfx_put_px(int x, int y, uint32_t argb);
+// Alpha-composite (src-over) a single ARGB pixel onto the canvas.
+void gfx_blend_px(int x, int y, uint32_t argb);
+void gfx_fill_circle(int cx, int cy, int r, uint32_t argb);
+// Filled rounded rectangle.
+void gfx_fill_round_rect(int x, int y, int w, int h, int r, uint32_t argb);
+// Alpha-composited (translucent) filled circle.
+void gfx_blend_circle(int cx, int cy, int r, uint32_t argb);
+// Progress ring (annulus): `track` for the full ring, `fill` for the swept
+// fraction [0,1] starting at 12 o'clock going clockwise.
+void gfx_ring(int cx, int cy, int r_out, int r_in, float frac,
+              uint32_t track, uint32_t fill);
+// Anti-aliased text at an arbitrary glyph height `h` (px); returns width drawn.
+int  gfx_draw_text_h(int x, int y, const char *s, int h, uint32_t argb);
+int  gfx_text_width_h(const char *s, int h);
+// Horizontally squeeze the AA text: percent of the cell height (25..100).
+void gfx_set_text_condense(int percent);
+
+#endif
diff -ruN a/src/video/rk_osd_hud.c b/src/video/rk_osd_hud.c
--- a/src/video/rk_osd_hud.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/video/rk_osd_hud.c	2026-08-29 10:56:33.492745152 +0200
@@ -0,0 +1,178 @@
+/*
+ * Stats HUD for the rk OSD. See rk_osd_hud.h.
+ */
+
+#include "rk_osd_hud.h"
+#include "rk_osd_gfx.h"
+#include "video.h"  // pulls in <Limelight.h> for the stats getters
+
+#include <stdio.h>
+#include <time.h>
+
+static int si_format;
+static int si_width, si_height;
+static char app_name[64];
+static volatile uint64_t video_bytes; // running total of received video bytes
+
+void rk_hud_add_video_bytes(unsigned bytes) {
+  video_bytes += bytes;
+}
+
+void rk_hud_set_stream_info(int video_format, int width, int height) {
+  si_format = video_format;
+  si_width = width;
+  si_height = height;
+}
+
+void rk_hud_set_app_name(const char *name) {
+  snprintf(app_name, sizeof app_name, "%s", name ? name : "");
+}
+
+static const char *codec_name(int fmt) {
+  if (fmt & VIDEO_FORMAT_MASK_H264) return "H.264";
+  if (fmt & VIDEO_FORMAT_MASK_H265) return (fmt & VIDEO_FORMAT_MASK_10BIT) ? "HEVC 10-bit" : "HEVC";
+  if (fmt & VIDEO_FORMAT_MASK_AV1)  return (fmt & VIDEO_FORMAT_MASK_10BIT) ? "AV1 10-bit" : "AV1";
+  return "?";
+}
+
+static uint32_t rtt_color(uint32_t rtt_ms) {
+  if (rtt_ms == 0) return COL_VALUE;
+  if (rtt_ms < 30) return COL_GOOD;
+  if (rtt_ms < 80) return COL_WARN;
+  return COL_BAD;
+}
+// Draw "label value" and return the x for the next segment (with trailing gap).
+static int draw_seg(int x, int y, int h, const char *label, const char *val,
+                    uint32_t vc) {
+  int a = gfx_draw_text_h(x, y, label, h, COL_LABEL);
+  a += gfx_draw_text_h(x + a, y, " ", h, COL_LABEL);
+  a += gfx_draw_text_h(x + a, y, val, h, vc);
+  return x + a + (h * 9) / 8; // one-space gap
+}
+
+// Like draw_seg but reserves at least `valw` px for the value, right-aligned,
+// so a changing number (e.g. RTT ms) doesn't shift the rest of the line.
+static int draw_seg_w(int x, int y, int h, const char *label, const char *val,
+                      uint32_t vc, int valw) {
+  int a = gfx_draw_text_h(x, y, label, h, COL_LABEL);
+  a += gfx_draw_text_h(x + a, y, " ", h, COL_LABEL);
+  int vw = gfx_text_width_h(val, h);
+  int slot = valw > vw ? valw : vw;
+  gfx_draw_text_h(x + a + slot - vw, y, val, h, vc);
+  return x + a + slot + (h * 9) / 8;
+}
+
+void rk_hud_render(int fps) {
+  const int W = gfx_w(), H = gfx_h();
+  const int h = (W >= 1280) ? 24 : 15;   // small anti-aliased glyph height
+  const int line = h + h / 2;
+  const int padv = h / 2, padx = h;
+  const int top = padv + 2;              // 2px larger top margin
+  const int bar_h = top + 2 * line + padv;
+  const int by = H - bar_h;              // full-width bar at the very bottom
+
+  gfx_fill_rect(0, by, W, bar_h, COL_PANEL);
+
+  int x = padx, y = by + top;
+  char buf[64];
+
+  // Line 1: profile/app name only.
+  const char *title = app_name[0] ? app_name : "Moonlight";
+  gfx_draw_text_h(x, y, title, h, COL_TITLE);
+
+  // Line 2: codec/resolution + live stats.
+  y += line;
+  int sx = x;
+  snprintf(buf, sizeof buf, "%s %dx%d", codec_name(si_format), si_width, si_height);
+  sx += gfx_draw_text_h(sx, y, buf, h, COL_LABEL) + (h * 9) / 8;
+
+  // Sample the live values at a fixed low rate; between samples the cached
+  // strings are re-drawn so the menu's frequent redraws don't jitter them.
+  static struct timespec last_sample;
+  static bool sampled;
+  static uint64_t last_bytes;
+  static char v_fps[16], v_rate[16], v_rtt[16], v_jitter[16], v_loss[16];
+  static char v_fec[16], v_oos[16];
+  static uint32_t col_rtt, col_jitter, col_loss, col_oos;
+  // Cumulative-count history for the ~5s FEC/OOS windows (12 samples @ 400ms).
+  static uint32_t fec_hist[26], oos_hist[26];
+  static int hist_head, hist_count;
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  double since = sampled ? (now.tv_sec - last_sample.tv_sec) * 1000.0 +
+                               (now.tv_nsec - last_sample.tv_nsec) / 1e6
+                         : 1e9;
+  if (since >= 400.0) {
+    bool had_prev = sampled;
+    double dt_s = since / 1000.0;
+    last_sample = now;
+    sampled = true;
+    snprintf(v_fps, sizeof v_fps, "%d", fps);
+
+    // Actual received video bitrate from the accumulated frame bytes.
+    uint64_t cur_bytes = video_bytes;
+    if (had_prev && dt_s > 0.05 && dt_s < 5.0)
+      snprintf(v_rate, sizeof v_rate, "%.1fM",
+               (double)(cur_bytes - last_bytes) * 8.0 / dt_s / 1e6);
+    else
+      snprintf(v_rate, sizeof v_rate, "0.0M");
+    last_bytes = cur_bytes;
+
+    uint32_t rtt = 0, rttvar = 0;
+    if (LiGetEstimatedRttInfo(&rtt, &rttvar)) {
+      snprintf(v_rtt, sizeof v_rtt, "%ums", rtt);
+      snprintf(v_jitter, sizeof v_jitter, "%ums", rttvar);
+    } else {
+      snprintf(v_rtt, sizeof v_rtt, "n/a");
+      snprintf(v_jitter, sizeof v_jitter, "n/a");
+    }
+    col_rtt = rtt_color(rtt);
+    col_jitter = rttvar < 10 ? COL_VALUE : rttvar < 30 ? COL_WARN : COL_BAD;
+
+    // Combined video + audio: loss %, FEC-recovered and OOS packet counts.
+    float loss = 0.0f;
+    uint32_t fecrec = 0, oos = 0;
+    uint64_t total = 0, failed = 0;
+    const RTP_VIDEO_STATS *vs = LiGetRTPVideoStats();
+    if (vs) {
+      total += vs->packetCountVideo;
+      failed += vs->packetCountFecFailed;
+      fecrec += vs->packetCountFecRecovered;
+      oos += vs->packetCountOOS;
+    }
+    const RTP_AUDIO_STATS *as = LiGetRTPAudioStats();
+    if (as) {
+      total += as->packetCountAudio;
+      failed += as->packetCountFecFailed;
+      fecrec += as->packetCountFecRecovered;
+      oos += as->packetCountOOS;
+    }
+    if (total)
+      loss = 100.0f * (float)failed / (float)total;
+    snprintf(v_loss, sizeof v_loss, "%.1f%%", loss);
+    col_loss = loss > 1.0f ? COL_BAD : COL_GOOD;
+
+    // FEC/OOS as the count accrued over the last ~5s (delta vs 12 samples ago).
+    int back = hist_count < 12 ? hist_count : 12;
+    int ref = (hist_head - back + 26) % 26;
+    uint32_t fec10 = fecrec - fec_hist[ref];
+    uint32_t oos10 = oos - oos_hist[ref];
+    fec_hist[hist_head] = fecrec;
+    oos_hist[hist_head] = oos;
+    hist_head = (hist_head + 1) % 26;
+    if (hist_count < 26)
+      hist_count++;
+    snprintf(v_fec, sizeof v_fec, "%u", fec10);
+    snprintf(v_oos, sizeof v_oos, "%u", oos10);
+    col_oos = oos10 ? COL_WARN : COL_VALUE;
+  }
+
+  sx = draw_seg(sx, y, h, "FPS", v_fps, COL_VALUE);
+  sx = draw_seg(sx, y, h, "Rate", v_rate, COL_VALUE);
+  int msw = gfx_text_width_h("000ms", h); // reserve three digits before "ms"
+  sx = draw_seg_w(sx, y, h, "RTT", v_rtt, col_rtt, msw);
+  sx = draw_seg_w(sx, y, h, "Jitter", v_jitter, col_jitter, msw);
+  sx = draw_seg(sx, y, h, "Loss", v_loss, col_loss);
+  sx = draw_seg(sx, y, h, "FEC", v_fec, COL_VALUE);
+  draw_seg(sx, y, h, "OOS", v_oos, col_oos);
+}
diff -ruN a/src/video/rk_osd_hud.h b/src/video/rk_osd_hud.h
