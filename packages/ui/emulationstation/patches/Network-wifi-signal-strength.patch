 #include "utils/Platform.h"
 
-NetworkStateWatcher::NetworkStateWatcher() : mIsConnected(false), mIsPlaneMode(false)
+#include <fstream>
+#include <sstream>
+
+NetworkStateWatcher::NetworkStateWatcher() : mIsConnected(false), mIsPlaneMode(false), mSignalStrength(-1)
 {
 	mIsPlaneModeSupported = IExternalActivity::Instance != nullptr && IExternalActivity::Instance->isReadPlaneModeSupported();
 }
 
+// Reads the wireless link quality reported by the driver in /proc/net/wireless
+// and returns it as a percentage (0..100), or -1 when no wireless link exists.
+int NetworkStateWatcher::readSignalStrength()
+{
+	std::ifstream file("/proc/net/wireless");
+	if (!file.is_open())
+		return -1;
+
+	std::string line;
+	std::getline(file, line); // header line 1
+	std::getline(file, line); // header line 2
+
+	while (std::getline(file, line))
+	{
+		std::string::size_type colon = line.find(':');
+		if (colon == std::string::npos)
+			continue;
+
+		std::istringstream stream(line.substr(colon + 1));
+		int status = 0;
+		float link = 0.0f;
+		if (!(stream >> status >> link))
+			continue;
+
+		// The "link" column is a quality value, conventionally out of 70.
+		int percent = (int)((link / 70.0f) * 100.0f + 0.5f);
+		if (percent < 0) percent = 0;
+		if (percent > 100) percent = 100;
+		return percent;
+	}
+
+	return -1;
+}
+
 bool NetworkStateWatcher::check()
 {
 	bool networkConnected = !Utils::Platform::queryIPAddress().empty();
 	bool planemodeEnabled = mIsPlaneModeSupported && IExternalActivity::Instance != nullptr && IExternalActivity::Instance->isPlaneMode();
 
-	bool changed = networkConnected != mIsConnected || mIsPlaneMode != planemodeEnabled;
+	int signal = networkConnected ? readSignalStrength() : -1;
+
+	// Bucket the strength into levels so minor fluctuations don't force a redraw.
+	auto level = [](int s) { return s < 0 ? -1 : s / 25; };
+	bool signalChanged = level(signal) != level(mSignalStrength);
+
+	bool changed = networkConnected != mIsConnected || mIsPlaneMode != planemodeEnabled || signalChanged;
 
 	mIsConnected = networkConnected;
 	mIsPlaneMode = planemodeEnabled;
+	mSignalStrength = signal;
 	
 	return changed;
 }
