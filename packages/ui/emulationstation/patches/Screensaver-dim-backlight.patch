+		// Fade the backlight down to the configured target level (0..100 %),
+		// but only when the current brightness is above that target. The UI
+		// underneath stays visible (no black overlay).
+		int max = readIntFromFile(BACKLIGHT_MAX_FILE);
+		int current = readIntFromFile(BACKLIGHT_BRIGHTNESS_FILE);
+		if (max > 0 && current >= 0)
+		{
+			int level = Settings::getInstance()->getInt("ScreenSaverDimBacklightLevel");
+			if (level < 0) level = 0;
+			if (level > 100) level = 100;
+
+			int target = (int)((level / 100.0f) * max + 0.5f);
+			if (current > target)
+			{
+				mSavedBrightness = current;
+				sDimSavedBrightness = current;
+				fadeBacklightRaw(current, target);
+			}
+		}
+	}
 
 	// No videos. Just use a standard screensaver
 	mState = STATE_SCREENSAVER_ACTIVE;
