+#define BACKLIGHT_BRIGHTNESS_FILE	"/sys/class/backlight/backlight/brightness"
+#define BACKLIGHT_MAX_FILE			"/sys/class/backlight/backlight/max_brightness"
+
+static int readIntFromFile(const char* path) {
+    FILE* f = fopen(path, "r");
+    if (!f)
+        return -1;
+    int value = -1;
+    if (fscanf(f, "%d", &value) != 1)
+        value = -1;
+    fclose(f);
+    return value;
+}
+
+static void writeIntToFile(const char* path, int value) {
+    FILE* f = fopen(path, "w");
+    if (!f)
+        return;
+    fprintf(f, "%d", value);
+    fclose(f);
+}
+
+// Smoothly fade the backlight from one raw brightness value to another,
+// one step per 8 ms, so dimming (and restoring) is not abrupt.
+static void fadeBacklightRaw(int from, int to) {
+    if (from < 0 || to < 0)
+        return;
+
+    int step = (to >= from) ? 1 : -1;
+    for (int b = from; b != to; b += step) {
+        writeIntToFile(BACKLIGHT_BRIGHTNESS_FILE, b);
+        usleep(8000);
+    }
+    writeIntToFile(BACKLIGHT_BRIGHTNESS_FILE, to);
+}
+
+// Raw backlight value saved while the "dim backlight" screensaver is active,
+// kept at file scope so it can be restored from onExit()/signal handlers if ES
+// is terminated while dimmed. -1 means "not dimmed".
+static int sDimSavedBrightness = -1;
+
+void SystemScreenSaver::restoreBacklightIfDimmed()
+{
+    if (sDimSavedBrightness < 0)
+        return;
+    writeIntToFile(BACKLIGHT_BRIGHTNESS_FILE, sDimSavedBrightness);
+    sDimSavedBrightness = -1;
+}
