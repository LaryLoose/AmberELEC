diff --git a/es-core/src/components/BrightnessInfoComponent.cpp b/es-core/src/components/BrightnessInfoComponent.cpp
new file mode 100644
index 000000000..9e8ec8a83
--- /dev/null
+++ b/es-core/src/components/BrightnessInfoComponent.cpp
@@ -0,0 +1,183 @@
+#include "BrightnessInfoComponent.h"
+#include "ThemeData.h"
+#include "PowerSaver.h"
+#include "components/ComponentGrid.h"
+#include "components/NinePatchComponent.h"
+#include "components/TextComponent.h"
+#include "components/ImageComponent.h"
+#include "utils/FileSystemUtil.h"
+#include "utils/StringUtil.h"
+#include "LocaleES.h"
+#include "Window.h"
+
+#define PADDING_PX			(Renderer::getScreenWidth()*0.006)
+#define PADDING_BAR			(Renderer::isSmallScreen() ? Renderer::getScreenWidth()*0.02 : Renderer::getScreenWidth()*0.006)
+
+#define VISIBLE_TIME		2650
+#define FADE_TIME			250
+#define CHECKBRIGHTNESSDELAY	40
+
+// Reads the current backlight brightness as a 0..100 percentage.
+// Returns -1 when no backlight is available (e.g. desktop builds) so the
+// overlay simply never triggers on such devices.
+static int readBrightnessPercent()
+{
+	static const std::string brightnessPath = "/sys/class/backlight/backlight/brightness";
+	static const std::string maxBrightnessPath = "/sys/class/backlight/backlight/max_brightness";
+
+	if (!Utils::FileSystem::exists(brightnessPath) || !Utils::FileSystem::exists(maxBrightnessPath))
+		return -1;
+
+	int max = Utils::String::toInteger(Utils::FileSystem::readAllText(maxBrightnessPath));
+	if (max <= 0)
+		return -1;
+
+	int value = Utils::String::toInteger(Utils::FileSystem::readAllText(brightnessPath));
+
+	int percent = (int)((value / (float)max) * 100.0f + 0.5f);
+	if (percent < 0)
+		percent = 0;
+	if (percent > 100)
+		percent = 100;
+
+	return percent;
+}
+
+BrightnessInfoComponent::BrightnessInfoComponent(Window* window, bool actionLine)
+	: GuiComponent(window)
+{
+	mDisplayTime = -1;
+	mBrightness = -1;
+	mCheckTime = 0;
+
+	auto theme = ThemeData::getMenuTheme();	
+
+	auto font = theme->TextSmall.font;
+	if (Renderer::isSmallScreen())
+		font = theme->Text.font;
+
+	Vector2f fullSize(
+		2 * PADDING_PX + font->sizeText("100%").x(),
+		2 * PADDING_PX + Renderer::getScreenHeight() * 0.20f);
+	
+	fullSize.y() = fullSize.x() * 2.5f;
+
+	setSize(fullSize);
+
+	mFrame = new NinePatchComponent(window);
+	mFrame->setImagePath(theme->Background.path);
+	mFrame->setEdgeColor(theme->Background.color);
+	mFrame->setCenterColor(theme->Background.centerColor);
+	mFrame->setCornerSize(theme->Background.cornerSize);
+	mFrame->setPostProcessShader(theme->Background.menuShader, false);
+	mFrame->fitTo(mSize, Vector3f::Zero(), Vector2f(-32, -32));
+	addChild(mFrame);
+
+	// Icon at the top of the overlay (tinted with the theme text color)
+	float iconSize = fullSize.x() - 2 * PADDING_PX - 2 * PADDING_BAR;
+	mIcon = new ImageComponent(mWindow);
+	mIcon->setImage(":/brightness.svg");
+	mIcon->setColorShift(theme->Text.color);
+	mIcon->setResize(iconSize, iconSize);
+	mIcon->setPosition(PADDING_PX + PADDING_BAR, PADDING_PX);
+	addChild(mIcon);
+
+	mLabel = new TextComponent(mWindow, "", font, theme->Text.color, ALIGN_CENTER);
+	
+	int h = font->sizeText("100%").y() + PADDING_PX;
+	mLabel->setPosition(0, fullSize.y() - h);
+	mLabel->setSize(fullSize.x(), h);
+	addChild(mLabel);
+
+	// FCA TopLeft
+	float posX = Renderer::getScreenWidth() * 0.02f;
+	float posY = Renderer::getScreenHeight() * 0.13f; //AmberELEC
+
+	setPosition(posX, posY, 0);
+}
+
+BrightnessInfoComponent::~BrightnessInfoComponent()
+{
+	delete mLabel;
+	delete mIcon;
+	delete mFrame;
+}
+
+void BrightnessInfoComponent::update(int deltaTime)
+{
+	GuiComponent::update(deltaTime);
+
+	if (mDisplayTime >= 0)
+	{
+		mDisplayTime += deltaTime;
+		if (mDisplayTime > VISIBLE_TIME + FADE_TIME)
+		{
+			mDisplayTime = -1;
+
+			if (isVisible())
+			{
+				setVisible(false);
+				PowerSaver::resume();
+			}
+		}
+	}
+
+	mCheckTime += deltaTime;
+	if (mCheckTime < CHECKBRIGHTNESSDELAY)
+		return;
+
+	mCheckTime = 0;
+
+	int brightness = readBrightnessPercent();
+	if (brightness < 0)
+		return;
+
+	if (brightness != mBrightness)
+	{
+		bool firstTime = (mBrightness < 0);
+
+		mBrightness = brightness;
+
+		mLabel->setText(std::to_string(mBrightness) + "%");
+
+		if (!firstTime)
+		{
+			mDisplayTime = 0;
+
+			if (!isVisible())
+			{
+				setVisible(true);
+				PowerSaver::pause();
+			}
+		}
+	}
+}
+
+void BrightnessInfoComponent::render(const Transform4x4f& parentTrans)
+{
+	if (!mVisible || mDisplayTime < 0)
+		return;
+
+	auto theme = ThemeData::getMenuTheme();
+
+	int opacity = 255 - Math::max(0, (mDisplayTime - VISIBLE_TIME) * 255 / FADE_TIME);
+	setOpacity(opacity);
+	setScale(opacity / 255.0f);
+
+	GuiComponent::render(parentTrans);
+
+	Transform4x4f trans = parentTrans * getTransform();
+	Renderer::setMatrix(trans);
+
+	float x = PADDING_PX + PADDING_BAR;
+	// leave room for the square icon at the top
+	float iconSize = getSize().x() - 2 * PADDING_PX - 2 * PADDING_BAR;
+	float y = PADDING_PX + iconSize + PADDING_PX;
+	float w = getSize().x() - 2 * PADDING_PX - 2 * PADDING_BAR;
+	float h = getSize().y() - mLabel->getSize().y() - PADDING_PX - y;
+	
+	Renderer::drawRect(x, y, w, h, (theme->Text.color & 0xFFFFFF00) | (opacity / 2));
+
+	float px = (h*mBrightness) / 100;
+	Renderer::drawRect(x, y + h - px, w, px, (theme->TextSmall.color & 0xFFFFFF00) | opacity);
+}
