+// SPDX-License-Identifier: GPL-2.0-or-later
+// Copyright (C) 2026-present AmberELEC (https://github.com/AmberELEC)
+
+#include "guis/GuiGameStreaming.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <fstream>
+#include <functional>
+#include <string>
