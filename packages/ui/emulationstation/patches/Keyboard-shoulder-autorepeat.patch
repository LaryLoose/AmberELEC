+void TextEditComponent::startTextInputRepeat(const char* text)
+{
+	if (!mEditing)
+		return;
+
+	mBlinkTime = 0;
+	mTextInputRepeatValue = text;
+	mTextInputRepeatTimer = -(CURSOR_REPEAT_START_DELAY - TEXTINPUT_REPEAT_SPEED);
+	textInput(text);
+}
+
+void TextEditComponent::stopTextInputRepeat()
+{
+	mTextInputRepeatValue.clear();
+}
