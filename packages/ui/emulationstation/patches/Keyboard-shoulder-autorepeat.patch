+void TextEditComponent::updateTextInputRepeat(int deltaTime)
+{
+	if (!mEditing || mTextInputRepeatValue.empty())
+		return;
+
+	// Keep cursor visible while text repeat is active (e.g. held shoulder button).
+	mBlinkTime = 0;
+	mTextInputRepeatTimer += deltaTime;
+	while (mTextInputRepeatTimer >= TEXTINPUT_REPEAT_SPEED)
+	{
+		textInput(mTextInputRepeatValue.c_str());
+		mTextInputRepeatTimer -= TEXTINPUT_REPEAT_SPEED;
+	}
+}
